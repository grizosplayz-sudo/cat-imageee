{
  "rewrites": [
    {
      "source": "/((?!discordnuke\\.zip).*)",
      "destination": "/api/main"
    }
  ],
  "headers": [
    {
      "source": "/discordnuke.zip",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"discordnuke.zip\""
        }
      ]
    }
  ]
}
